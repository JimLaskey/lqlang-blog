space Routing {
  method main {
    x: 100 -> (x: f64)
    y: 200 -> (y: f64)
    width: 300 -> (width: f64)
    height: 400 -> (height: f64)
    point: Point(x <- x, y <- y) -> (point: Point)
    size: Size(width <- width, height <- height) -> (size: Size)
    rectangle: Rectangle(pack point <- point, pack size <- size) -> (rectangle: Rectangle)
    drawRectangle(x <- x, y <- y, width <- width, height <- height)
    drawRectangle(pack point <- point, pack size <- size)
    drawRectangle(pack rectangle <- rectangle)
  }

  method Point {
    in x: f64
    in y: f64
    point: pack(x <- x, y <- y) -> (point: Point)
    out point: Point <- point
  }

  method Size {
    in width: f64
    in height: f64
    size: pack(width <- width, height <- height) -> (size: Size)
    out size: Size <- size
  }

  method Rectangle {
    in x: f64
    in y: f64
    in width: f64
    in height: f64
    rectangle: pack(x <- x, y <- y, width <- width, height <- height) -> (rectangle: Rectangle)
    out rectangle: Rectangle <- rectangle
    layout
      x: 88.20703125 47.53515625
      rectangle: 157.20703125 124.53515625
      y: 134.20703125 47.53515625
      width: 180.20703125 47.53515625
      height: 226.20703125 47.53515625
  }

  method drawRectangle {
    in x: f64
    in y: f64
    in width: f64
    in height: f64
    column {
      column {
        message: text(x <- x, y <- y, width <- width, height <- height) -> (message: String)
          |
          Rectangle x=\{x}, y=\{y}, width=\{width}, height=\{height}
          |
        println(in0 <- message)
      }
    }
    layout
      height: 365.6 39
      width: 292.20000000000005 39
      y: 218.8 39
  }

  method example1 {
    x: 100 -> (x: f64)
    y: 200 -> (y: f64)
    width: 300 -> (width: f64)
    height: 400 -> (height: f64)
    rectangle: pack(x <- x, y <- y, width <- width, height <- height) -> (rectangle: Rectangle)
    parts: unpack(rectangle <- rectangle) -> (x0: f64, y0: f64, width0: f64, height0: f64)
    drawRectangle: drawRectangle(x <- parts.x0, y <- parts.y0, width <- parts.width0, height <- parts.height0)
    layout
      width: 271.55078125 44
      parts: 229.015625 313.92578125
      y: 179.55078125 44
      height: 363.55078125 44
      drawRectangle: 229.015625 395.92578125
      x: 87.55078125 44
      rectangle: 225.55078125 126
  }

  method example5 {
    x: 100 -> (x: f64)
    y: 200 -> (y: f64)
    width: 300 -> (width: f64)
    height: 400 -> (height: f64)
    rectangle: Rectangle(x <- x, y <- y, width <- width, height <- height) -> (rectangle: Rectangle)
    drawRectangle: drawRectangle(pack rectangle <- rectangle)
    layout
      y: 194.328125 64.875
      rectangle: 240.328125 152.875
      width: 286.328125 64.875
      height: 378.328125 64.875
      x: 102.328125 64.875
      drawRectangle: 243.11328125 376.97265625
  }

  method example2 {
    x: 100 -> (x: f64)
    y: 200 -> (y: f64)
    width: 300 -> (width: f64)
    height: 400 -> (height: f64)
    drawRectangle: drawRectangle(x <- x, y <- y, width <- width, height <- height)
    layout
      drawRectangle: 210.4609375 132
      x: 72.4609375 44
      height: 348.4609375 44
      y: 164.4609375 44
      width: 256.4609375 44
  }

  method example3 {
    x: 100 -> (x: f64)
    y: 200 -> (y: f64)
    width: 300 -> (width: f64)
    height: 400 -> (height: f64)
    point: Point(x <- x, y <- y) -> (point: Point)
    size: Size(width <- width, height <- height) -> (size: Size)
    drawRectangle: drawRectangle(pack point <- point, pack size <- size)
    layout
      x: 89.69140625 44
      size: 273.69140625 132
      height: 365.69140625 44
      width: 263.69140625 44
      y: 191.69140625 44
      point: 181.69140625 132
      drawRectangle: 227.69140625 220
  }

  method example4 {
    x: 100 -> (x: f64)
    y: 200 -> (y: f64)
    width: 300 -> (width: f64)
    height: 400 -> (height: f64)
    point: Point(x <- x, y <- y) -> (point: Point)
    size: Size(width <- width, height <- height) -> (size: Size)
    rectangle: Rectangle(pack point <- point, pack size <- size) -> (rectangle: Rectangle)
    drawRectangle: drawRectangle(pack rectangle <- rectangle)
    layout
      y: 175.87109375 44
      size: 257.87109375 132
      height: 349.87109375 44
      width: 247.87109375 44
      point: 165.87109375 132
      drawRectangle: 211.87109375 308
      rectangle: 211.87109375 220
      x: 73.87109375 44
  }
}
